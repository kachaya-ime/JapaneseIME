<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="基本入力設定"
        app:iconSpaceReserved="false">

        <ListPreference
            android:defaultValue="japanese"
            android:entries="@array/startup_modes"
            android:entryValues="@array/startup_mode_values"
            android:key="startup_mode"
            android:title="起動時の入力モード"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="use_kuten_jp"
            android:summaryOff="「.」で「．」を入力します"
            android:summaryOn="「.」で「。」を入力します"
            android:title="句点に「。」を使用する" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="use_touten_jp"
            android:summaryOff="「,」で「，」を入力します"
            android:summaryOn="「,」で「、」を入力します"
            android:title="読点に「、」を使用する" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="auto_ascii_mode"
            android:summary="URI入力時に自動的に英字モードに切り替えます"
            android:title="入力形式による自動モード切替" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Viterbi 変換設定"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="viterbi_enabled"
            android:summaryOff="Viterbi による統計的かな漢字変換を行いません"
            android:summaryOn="Viterbi による統計的かな漢字変換を行います"
            android:title="Viterbi 変換を使用する" />

        <EditTextPreference
            android:defaultValue="10"
            android:key="viterbi_nbest"
            android:title="N-best 候補検索数 (viterbi_nbest)"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>
